#!system=ios

[Script]
booking_sessions = type=http-response,pattern=^https?:\/\/(wap|www)\.tiananmenchenglou\.com\/mmodule\/com\.mpwork\.tickets6\/ajax\/bookingquery\/sessions,requires-body=1,max-size=0,script-path=https://fastly.jsdelivr.net/gh/467853817/tam-sessions-surge-module@main/booking_sessions.js,timeout=30

[MITM]
hostname = %APPEND% wap.tiananmenchenglou.com, www.tiananmenchenglou.com
